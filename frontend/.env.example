VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Firebase SDK (for FCM push notifications on Android/Chrome)
# 1. Create a project on Firebase Console
# 2. Add a "Web App" to the project
# 3. Copy the firebaseConfig values here:
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# 4. Under Project Settings -> Cloud Messaging -> Web configuration
# 5. Generate a new Key Pair (VAPID key) and copy it here:
VITE_FIREBASE_VAPID_KEY=your-vapid-key
