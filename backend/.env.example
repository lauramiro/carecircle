NODE_ENV=development
PORT=3000

FRONTEND_PUBLIC_URL=http://localhost:5173
GMAIL_USER=carecircle.quantic@gmail.com
GMAIL_APP_PASSWORD="bvss zjea oast unkg" # ensure it is put inside quotes
MAIL_FROM=carecircle.quantic@gmail.com
MAIL_FROM_NAME=CareCircle

# Supabase — Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only (crons, materialization, alerts). NEVER expose to the browser or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — run in backend/: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:carecircle.quantic@gmail.com

# Alert pipeline crons (see medication_schedule_checklist_push_notification_sms_alert_design.md)
CRON_ENABLED=true
SMS_FALLBACK_DELAY_MINUTES=10
MATERIALIZATION_BATCH_SIZE=100

# Twilio (CC-100) — never commit real credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEV_TEST_TO_NUMBER=
